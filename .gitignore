# Visual Studio 2015+ user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
Outbreak/Outbreak/SourceArt/**/*.png
Outbreak/Outbreak/SourceArt/**/*.tga

# Binary Files
Outbreak/Outbreak/Binaries/*
Outbreak/Outbreak/Plugins/**/Binaries/*

# Builds
Outbreak/Outbreak/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Outbreak/Outbreak/Build/*/
Outbreak/Outbreak/Build/**/*
!Outbreak/Outbreak/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Outbreak/Outbreak/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Outbreak/Outbreak/Saved/*

# Compiled source files for the engine to use
Outbreak/Outbreak/Intermediate/*
Outbreak/Outbreak/Plugins/**/Intermediate/*

# Cache files for the editor to use
Outbreak/Outbreak/DerivedDataCache/*
